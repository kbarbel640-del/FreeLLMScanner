# FreeLLMScanner environment example
# Copy to .env and fill in the values you actually use.
# Never commit your real .env file.

# API keys
OPENROUTER_API_KEY=
KILO_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
VERCEL_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_API_KEY=

# Optional per-provider delay between model test requests, in seconds.
# Defaults are handled by the scripts; only set values here when overriding them.
# Fractional values like 0.5 or 1.2 are valid for sleep.
OPENCODE_RATE_LIMIT_SECONDS=1
OPENROUTER_RATE_LIMIT_SECONDS=1
KILO_RATE_LIMIT_SECONDS=1
NVIDIA_RATE_LIMIT_SECONDS=1
GROQ_RATE_LIMIT_SECONDS=1
CEREBRAS_RATE_LIMIT_SECONDS=1
VERCEL_RATE_LIMIT_SECONDS=1
DEEPSEEK_RATE_LIMIT_SECONDS=1
MISTRAL_RATE_LIMIT_SECONDS=1
CLOUDFLARE_RATE_LIMIT_SECONDS=1

# Optional OpenCode/PVPN fallback
# PVPN_USER=
# PVPN_PASS=
# PVPN_HOSTS="nl-ams.pvdata.host se-sto.pvdata.host"
